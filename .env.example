# Copia este archivo como .env y llena los valores. Nunca subas el .env al repo.

# IA (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# Modelo y esfuerzo. Por defecto claude-opus-5-5 con esfuerzo bajo. Para bajar costos puedes probar claude-haiku-5-5.
MODELO=claude-opus-5-5
ESFUERZO=low

# WhatsApp Cloud API (developers.facebook.com > tu app > WhatsApp > Configuración de la API)
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_APP_SECRET=
# Una palabra que tú inventas; la misma va en "Verify token" del webhook en Meta
WA_VERIFY_TOKEN=
# Plantilla aprobada (categoría Utilidad) con un parámetro {{1}}, para avisos fuera de la ventana de 24 h
WA_PLANTILLA_AVISO=aviso_general
WA_PLANTILLA_IDIOMA=es

# Dirección pública del servidor (para los enlaces del panel)
BASE_URL=https://tu-servidor.com
PORT=3000
DB_RUTA=datos/asistente.db
HORA_AVISOS=09:00

# Cobros con Lemon Squeezy (opcional por ahora)
LINK_PAGO=
LEMON_SECRETO=
